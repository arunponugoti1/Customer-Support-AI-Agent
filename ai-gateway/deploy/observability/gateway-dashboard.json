{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "AI Gateway (Layer 2)",
  "tags": ["ai-gateway", "litellm"],
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Gateway total spend (USD)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(litellm_spend_metric_total)" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Spend by model (USD)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 9, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 5 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (model) (litellm_spend_metric_total)", "legendFormat": "{{model}}" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Spend by API key (USD)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 9, "x": 15, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 5 }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (api_key_alias) (litellm_spend_metric_total)", "legendFormat": "{{api_key_alias}}" } ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Tokens/sec by model",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (model) (rate(litellm_total_tokens_metric_total[5m]))", "legendFormat": "{{model}}" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Gateway request latency p95 (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(litellm_request_total_latency_metric_bucket[5m])))", "legendFormat": "p95" } ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Guardrail events (PII masked / injection) — llm-proxy",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (type) (llm_guardrail_events_total)", "legendFormat": "{{type}}" } ]
    }
  ]
}
